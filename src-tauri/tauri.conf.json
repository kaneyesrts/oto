{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oto",
  "version": "0.1.0",
  "identifier": "app.oto.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": [
      "wordsync"
    ]
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "oto",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "center": true,
        "visible": true,
        "backgroundColor": "#0d0d0f"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "kaneyesrts",
    "copyright": "© 2026 kaneyesrts · MIT",
    "category": "Music",
    "shortDescription": "Музыкальный плеер, который подстраивается под песню",
    "longDescription": "Файлы, Яндекс Музыка, SoundCloud и Spotify в одной библиотеке; лирика, синхронная с голосом; шейдерные пространства в такт музыке.",
    "homepage": "https://github.com/kaneyesrts/oto",
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
